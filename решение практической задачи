
public class Main {
    public static void main(String[] args) {
        Main app = new Main();

        // Проверяем работу метода на примере (10 мониторов, 3 программиста)
        int leftMonitors = app.drawsMonitorsCounter(10, 3);
        System.out.println("Осталось мониторов: " + leftMonitors); // Должно вывести 1

        // Еще один тест (15 мониторов, 4 программиста)
        System.out.println("Осталось мониторов (15 % 4): " + app.drawsMonitorsCounter(15, 4)); // Должно вывести 3
    }

    // Наш метод
    public int drawsMonitorsCounter(int monitors, int programmers) {
        return monitors % programmers;
    }
}
public class Main {
    public static void main(String[] args) {
        Main app = new Main();

        // Тест 1: Цена 8.50, количество 2
        double total1 = app.priceCalculation(8.50, 2);
        System.out.println("Итоговая стоимость (8.50 * 2): " + total1); // Ожидаем 17.0

        // Тест 2: Цена 12.35, количество 3
        double total2 = app.priceCalculation(12.35, 3);
        System.out.println("Итоговая стоимость (12.35 * 3): " + total2); // Ожидаем 37.05
    }

    // Наш метод расчета стоимости
    public double priceCalculation(double price, int count) {
        return price * count;
    }
}
